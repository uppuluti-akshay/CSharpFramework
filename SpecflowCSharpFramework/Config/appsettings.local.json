{
  "$schema": "https://specflow.org/specflow-config.json",
  "baseApiUrl": "https://jsonplaceholder.typicode.com",

  "selenium": {
    "browser": "chrome",
    "runHeadless": false, // if we maintain true it will run in headless mode.
    "timeOutInSeconds": 60,
    "webdriverLocation": "",
    "binaryLocation": ""

  },
  "Authentication": {
    "Type": "basic", // Options: basic, bearer, oauth2, none
    "Username": "your-username",
    "Password": "your-password",
    "Token": "your-bearer-token"
  }


}
